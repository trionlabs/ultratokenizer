{
  "name": "ultratokenizer-public-demo",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../../apps/web/build",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "PUBLIC_ORIGIN": "",
    "DOCUMENT_SERVICE_ORIGIN": "",
  },
}
