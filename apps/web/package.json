{
  "name": "@ultratokenizer/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-llm-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:demo": "node scripts/preview-demo.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:browser": "node test/header-browser.mjs && node test/judge-browser.mjs && node test/demo-browser.mjs && node test/hosted-deployment-browser.mjs && node test/document-browser.mjs && node test/worker-browser.mjs && node test/security-browser.mjs",
    "test:browser:backends": "node test/backend-browser.mjs",
    "test:browser:institution": "node test/institution-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  }
}
