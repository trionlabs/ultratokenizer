{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "contracts/ats/vendor/**",
    "contracts/ats/node_modules/**",
    "contracts/ats/build/**",
    "contracts/ats/compilers/**",
    "apps/web/**",
    "workers/issuance/node_modules/**",
    "workers/issuance/build/**",
    "workers/issuance/worker-configuration.d.ts",
    "workers/issuance/package-lock.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
