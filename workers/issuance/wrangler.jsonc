{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultratokenizer-issuance",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "durable_objects": {
    "bindings": [
      { "name": "TENANTS", "class_name": "IssuanceTenantCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IssuanceCoordinator"] },
    {
      "tag": "v2-tenant-quotas",
      "new_sqlite_classes": ["IssuanceTenantCoordinator"],
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "vars": {
    "AUTH_ISSUER": "",
    "AUTH_AUDIENCE": "",
    "AUTH_JWKS": "{\"keys\":[]}",
    "ALLOWED_ORIGIN": "",
    "CHAIN_ID": "296",
    "GATE_ADDRESS": "",
    "GATE_CODE_HASH": "",
    "RPC_URL": "",
    "MIN_CONFIRMATIONS": "2",
  },
}
